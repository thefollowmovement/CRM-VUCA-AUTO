// =====================================================================
//  VUCA AUTO CRM — Schéma de base de données (Prisma 7 / PostgreSQL)
//  Statut : validé en Phase 0 (18/10/2026)
// ---------------------------------------------------------------------
//  Conventions :
//   - Montants en CENTIMES (Int), champs suffixés « Centimes ».
//       ex. prixAchatCentimes = 800000  →  8 000,00 €
//   - Pourcentages en POINTS DE BASE (Int), champs suffixés « Bp ».
//       100 = 1 %, 2000 = 20 %, 10000 = 100 %
//   - Dates/heures stockées en UTC, affichées en Europe/Paris.
//     Les dates « calendaires » (naissance, échéances…) sont en @db.Date.
//   - Suppression douce : champ archiveLe (null = actif).
//   - Aucun calcul de TVA : tous les montants sont « payés / encaissés ».
//   - L'URL de connexion à la base est dans prisma.config.ts (Prisma 7).
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
//  ÉNUMÉRATIONS
// =====================================================================

enum Role {
  ADMIN
  GESTIONNAIRE
  INVESTISSEUR_LECTURE
}

enum TypePartenaire {
  SOCIETE
  INVESTISSEUR
}

enum TypeExploitation {
  ACHAT_REVENTE
  LOCATION
  MIXTE
}

enum StatutVehicule {
  EN_PREPARATION
  EN_VENTE
  RESERVE
  DISPONIBLE_LOCATION
  EN_LOCATION
  IMMOBILISE
  VENDU
  ARCHIVE
}

enum Carburant {
  ESSENCE
  DIESEL
  HYBRIDE
  HYBRIDE_RECHARGEABLE
  ELECTRIQUE
  GPL
  E85
  AUTRE
}

enum Boite {
  MANUELLE
  AUTOMATIQUE
}

enum CritAir {
  CRIT_AIR_0 // électrique / hydrogène (vignette verte)
  CRIT_AIR_1
  CRIT_AIR_2
  CRIT_AIR_3
  CRIT_AIR_4
  CRIT_AIR_5
  NON_CLASSE
}

enum Provenance {
  PARTICULIER
  PROFESSIONNEL
  ENCHERES
  IMPORT
  REPRISE
  AUTRE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE_BANCAIRE
  PRELEVEMENT
  AUTRE
}

enum ModeRepartition {
  PRORATA_INVESTISSEMENT
  POURCENTAGE_FIXE
}

enum Civilite {
  M
  MME
}

enum TypePieceIdentite {
  CARTE_IDENTITE
  PASSEPORT
  TITRE_SEJOUR
  AUTRE
}

enum TypeLocation {
  JOURNALIERE
  HEBDOMADAIRE
  MENSUELLE
}

// EN_RETARD n'est PAS stocké : il est calculé à l'affichage
// (statut EN_COURS + date de retour prévue dépassée). Voir CLAUDE.md.
enum StatutContrat {
  RESERVATION
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum ModeCaution {
  EMPREINTE_CB
  CHEQUE
  ESPECES
  VIREMENT
}

enum StatutCaution {
  A_ENCAISSER
  ENCAISSEE
  RESTITUEE
  RETENUE_PARTIELLE
  RETENUE_TOTALE
}

enum ModeTarifOption {
  PAR_JOUR
  FORFAIT
}

enum TypeEtatDesLieux {
  DEPART
  RETOUR
}

enum Proprete {
  PROPRE
  CORRECT
  SALE
}

enum VueVehicule {
  DESSUS
  AVANT
  ARRIERE
  COTE_GAUCHE
  COTE_DROIT
  INTERIEUR
}

enum TypeDommage {
  RAYURE
  BOSSE
  IMPACT
  ECLAT
  JANTE_ABIMEE
  VITRE
  INTERIEUR
  AUTRE
}

enum GraviteDommage {
  LEGER
  MOYEN
  IMPORTANT
}

enum TypeFraisSupplementaire {
  KM_SUPPLEMENTAIRES
  CARBURANT
  NETTOYAGE
  DOMMAGES
  RETARD
  LIVRAISON
  AMENDE_REFACTUREE
  FRAIS_DOSSIER
  AUTRE
  FRAIS_GESTION_AMENDE // frais de gestion facturés quand le conducteur d'un PV est désigné
}

// EN_RETARD n'est PAS stocké : calculé (date d'échéance dépassée et non payée).
enum StatutEcheance {
  A_VENIR
  PARTIELLE
  PAYEE
  ANNULEE
}

// Nature d'un encaissement. Les cautions encaissées puis restituées ne sont
// jamais des Paiements ; seule la part RETENUE devient un revenu.
enum NaturePaiement {
  LOCATION // loyer, acompte, solde
  FRAIS // frais supplémentaires (km, carburant, dommages…)
  CAUTION_RETENUE
  REMBOURSEMENT // argent rendu au client (montant positif, soustrait des revenus)
}

// Circuit des PV : A_LIRE (scan déposé) → A_VALIDER (lu par Claude, rapproché) → A_DESIGNER
// (validé) → CONDUCTEUR_DESIGNE (désigné à l'ANTAI). PAYEE = payé par la société.
// RECUE = ancien statut (avant le module d'import), plus proposé.
enum StatutAmende {
  RECUE
  CONDUCTEUR_DESIGNE
  PAYEE
  REFACTUREE
  A_LIRE
  A_VALIDER
  A_DESIGNER
  CONTESTE
  IGNORE
}

enum TypeAvis {
  CONTRAVENTION
  AMENDE_FORFAITAIRE_DELICTUELLE
  AMENDE_MAJOREE
  AUTRE
}

enum StatutSinistre {
  DECLARE
  EN_EXPERTISE
  EN_REPARATION
  CLOTURE
}

enum TypeVersement {
  REMBOURSEMENT_CAPITAL
  VERSEMENT_BENEFICE
  APPORT_SUPPLEMENTAIRE
}

enum TypeFacture {
  LOCATION
  VENTE_VEHICULE
  AUTRE
}

enum CategorieFichier {
  // Véhicule
  PHOTO_VEHICULE
  CARTE_GRISE
  FACTURE_ACHAT
  CONTROLE_TECHNIQUE
  CERTIFICAT_CESSION
  ATTESTATION_ASSURANCE
  DOCUMENT_VEHICULE_AUTRE
  // Dépense
  JUSTIFICATIF_DEPENSE
  // Client
  PERMIS_RECTO
  PERMIS_VERSO
  PIECE_IDENTITE_RECTO
  PIECE_IDENTITE_VERSO
  JUSTIFICATIF_DOMICILE
  DOCUMENT_CLIENT_AUTRE
  // État des lieux (photos guidées)
  EDL_AVANT
  EDL_ARRIERE
  EDL_COTE_GAUCHE
  EDL_COTE_DROIT
  EDL_INTERIEUR_AVANT
  EDL_INTERIEUR_ARRIERE
  EDL_COMPTEUR
  EDL_LIBRE
  SIGNATURE
  // Dommages, sinistres, amendes
  PHOTO_DOMMAGE
  PHOTO_SINISTRE
  DOCUMENT_SINISTRE
  AVIS_CONTRAVENTION
  // Divers
  PDF_ARCHIVE // copie figée d'un PDF signé (contrat, EDL)
  LOGO
  IMAGE_SITE // logos, favicon, photos « À propos » / vendeur, image de partage du site public
}

// =====================================================================
//  UTILISATEURS & AUDIT
// =====================================================================

model Utilisateur {
  id                    String    @id @default(cuid())
  nom                   String
  email                 String    @unique
  motDePasseHash        String // bcrypt
  role                  Role      @default(GESTIONNAIRE)
  actif                 Boolean   @default(true)
  doitChangerMotDePasse Boolean   @default(false)
  derniereConnexionLe   DateTime?

  // Uniquement pour le rôle INVESTISSEUR_LECTURE : le partenaire qu'il représente
  partenaireId String?     @unique
  partenaire   Partenaire? @relation(fields: [partenaireId], references: [id])

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  journal           JournalActivite[]
  historiquesStatut HistoriqueStatutVehicule[]
  fichiersEnvoyes   Fichier[]
  etatsDesLieux     EtatDesLieux[]
  amendesCreees     Amende[]                   @relation("AmendesCreees")
  lotsAmendes       LotImportAmendes[]
}

/// Trace chaque création / modification / suppression (montants en priorité).
model JournalActivite {
  id            String       @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  action        String // CREATION | MODIFICATION | SUPPRESSION | ARCHIVAGE | CONNEXION | ANONYMISATION…
  entite        String // "Vehicule", "Depense", "Paiement"…
  entiteId      String?
  avant         Json?
  apres         Json?
  creeLe        DateTime     @default(now())

  @@index([entite, entiteId])
  @@index([creeLe])
}

// =====================================================================
//  PARTENAIRES (qui met l'argent)
// =====================================================================

model Partenaire {
  id         String         @id @default(cuid())
  nom        String
  type       TypePartenaire @default(INVESTISSEUR)
  estSysteme Boolean        @default(false) // true pour « VUCA AUTO » : non supprimable
  telephone  String?
  email      String?
  iban       String? // affiché masqué (FR76 •••• •••• 1234)
  notes      String?
  actif      Boolean        @default(true)
  creeLe     DateTime       @default(now())
  modifieLe  DateTime       @updatedAt

  utilisateur    Utilisateur?
  participations Participation[]
  depensesPayees Depense[]
  partsFixes     PartBeneficeFixe[]
  versements     Versement[]
}

// =====================================================================
//  VÉHICULE
// =====================================================================

model Vehicule {
  id String @id @default(cuid())

  // --- Identité ---
  marque                String
  modele                String
  version               String?
  immatriculation       String?    @unique // AA-123-AA ou ancien format ; null possible (import en cours)
  vin                   String?    @unique
  annee                 Int?
  dateMiseEnCirculation DateTime?  @db.Date
  carburant             Carburant?
  boite                 Boite?
  couleur               String?
  nombrePlaces          Int?
  puissanceFiscale      Int? // CV
  critAir               CritAir?
  kilometrageActuel     Int? // mis à jour par les états des lieux et la vente
  kilometrageActuelLe   DateTime?

  // --- Exploitation ---
  typeExploitation TypeExploitation @default(ACHAT_REVENTE)
  statut           StatutVehicule   @default(EN_PREPARATION)

  // --- Achat ---
  dateAchat         DateTime    @db.Date
  prixAchatCentimes Int
  kilometrageAchat  Int?
  provenance        Provenance?
  nomVendeur        String?
  lienAnnonce       String?
  notesAchat        String?

  // Financement : si la somme des participations ≠ prix d'achat, l'utilisateur
  // doit confirmer explicitement l'écart (sinon enregistrement bloqué).
  ecartFinancementAccepte Boolean @default(false)
  ecartFinancementMotif   String?

  // --- Vente ---
  prixCibleCentimes Int? // prix affiché / cible
  prixVenteCentimes Int?
  dateVente         DateTime?     @db.Date
  kilometrageVente  Int?
  acheteurNom       String?
  acheteurTelephone String?
  acheteurEmail     String?
  acheteurAdresse   String?
  modePaiementVente ModePaiement?
  notesVente        String?

  // --- Location (valeurs par défaut reprises dans les contrats) ---
  tarifJournalierCentimes Int?
  tarifHebdoCentimes      Int?
  tarifMensuelCentimes    Int?
  kmInclusParJour         Int?
  kmInclusParMois         Int?
  prixKmSupCentimes       Int?
  cautionDefautCentimes   Int?
  franchiseDefautCentimes Int?
  dateMiseEnLocation      DateTime? @db.Date

  // --- Échéances & entretien ---
  dateProchainControleTechnique DateTime? @db.Date
  assureur                      String?
  numeroPoliceAssurance         String?
  dateEcheanceAssurance         DateTime? @db.Date
  dateProchaineVidange          DateTime? @db.Date
  kmProchaineVidange            Int?
  dateProchaineRevision         DateTime? @db.Date
  kmProchaineRevision           Int?

  // --- Répartition du bénéfice (section 5.3) ---
  modeRepartition     ModeRepartition @default(PRORATA_INVESTISSEMENT)
  commissionGestionBp Int             @default(0) // 2000 = 20 % pour VUCA AUTO avant partage

  notes     String?
  archiveLe DateTime?
  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt

  participations    Participation[]
  partsFixes        PartBeneficeFixe[]
  historiqueStatuts HistoriqueStatutVehicule[]
  estimations       EstimationValeur[]
  depenses          Depense[]
  fichiers          Fichier[]
  contrats          ContratLocation[]
  dommages          Dommage[]
  amendes           Amende[]
  sinistres         Sinistre[]
  versements        Versement[]
  factures          Facture[]
  annonce           Annonce?

  @@index([statut])
  @@index([typeExploitation])
  @@index([dateAchat])
  @@index([marque])
}

/// Historique horodaté des changements de statut (sert aussi à exclure les
/// jours IMMOBILISE du taux d'occupation).
model HistoriqueStatutVehicule {
  id            String          @id @default(cuid())
  vehiculeId    String
  vehicule      Vehicule        @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  ancienStatut  StatutVehicule?
  nouveauStatut StatutVehicule
  changeLe      DateTime        @default(now())
  motif         String?
  utilisateurId String?
  utilisateur   Utilisateur?    @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([vehiculeId, changeLe])
}

/// Valeur estimée actuelle (saisie manuelle, datée). La plus récente fait foi.
model EstimationValeur {
  id              String   @id @default(cuid())
  vehiculeId      String
  vehicule        Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  montantCentimes Int
  estimeLe        DateTime @db.Date
  source          String? // "Argus", "La Centrale", "estimation perso"…
  note            String?
  creeLe          DateTime @default(now())

  @@index([vehiculeId, estimeLe])
}

// =====================================================================
//  FINANCEMENT DE L'ACHAT
// =====================================================================

model Participation {
  id              String     @id @default(cuid())
  vehiculeId      String
  vehicule        Vehicule   @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  partenaireId    String
  partenaire      Partenaire @relation(fields: [partenaireId], references: [id])
  montantCentimes Int
  date            DateTime   @db.Date
  note            String?
  creeLe          DateTime   @default(now())
  modifieLe       DateTime   @updatedAt

  @@index([vehiculeId])
  @@index([partenaireId])
}

/// Mode POURCENTAGE_FIXE : % de partage du bénéfice saisis à la main
/// (total = 10000 bp = 100 %). Le capital remboursé reste ce que chacun a investi.
model PartBeneficeFixe {
  id            String     @id @default(cuid())
  vehiculeId    String
  vehicule      Vehicule   @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  partenaireId  String
  partenaire    Partenaire @relation(fields: [partenaireId], references: [id])
  pourcentageBp Int

  @@unique([vehiculeId, partenaireId])
}

// =====================================================================
//  DÉPENSES
// =====================================================================

model CategorieDepense {
  id      String  @id @default(cuid())
  code    String? @unique // code stable pour le seed (ex. "CARTE_GRISE")
  nom     String
  icone   String? // nom d'icône lucide-react
  couleur String? // ex. "#2563eb"
  ordre   Int     @default(0)
  actif   Boolean @default(true)

  depenses Depense[]
}

model Depense {
  id              String           @id @default(cuid())
  vehiculeId      String
  vehicule        Vehicule         @relation(fields: [vehiculeId], references: [id])
  date            DateTime         @db.Date
  categorieId     String
  categorie       CategorieDepense @relation(fields: [categorieId], references: [id])
  libelle         String
  montantCentimes Int
  payeParId       String // obligatoire — VUCA AUTO présélectionné dans le formulaire
  payePar         Partenaire       @relation(fields: [payeParId], references: [id])
  // Payée avec l'argent des loyers du véhicule : réduit le résultat mais ne
  // compte comme investissement pour personne (décision Phase 0, question 2).
  payeSurRecettes Boolean          @default(false)
  fournisseur     String?
  kilometrage     Int?
  note            String?
  sinistreId      String? // dépense liée à un sinistre (réparation…)
  sinistre        Sinistre?        @relation(fields: [sinistreId], references: [id], onDelete: SetNull)
  creeLe          DateTime         @default(now())
  modifieLe       DateTime         @updatedAt

  justificatifs      Fichier[]
  dommagesReparesPar Dommage[]

  @@index([vehiculeId, date])
  @@index([categorieId])
  @@index([payeParId])
  @@index([date])
}

// =====================================================================
//  LOCATION — CLIENTS
// =====================================================================

model Client {
  id                String    @id @default(cuid())
  civilite          Civilite?
  nom               String
  prenom            String?
  dateNaissance     DateTime? @db.Date
  lieuNaissance     String?
  paysNaissance     String? // désignation ANTAI
  adresse           String?
  adresseComplement String? // bâtiment, étage… (désignation ANTAI)
  codePostal        String?
  ville             String?
  pays              String?   @default("France")
  telephone         String?
  email             String?

  numeroPermis         String?
  dateObtentionPermis  DateTime? @db.Date
  dateDelivrancePermis DateTime? @db.Date // date de délivrance du titre (case 4a) — demandée par l'ANTAI
  paysDelivrancePermis String?   @default("France")
  categoriePermis      String?   @default("B")
  dateValiditePermis   DateTime? @db.Date

  typePieceIdentite         TypePieceIdentite?
  numeroPieceIdentite       String?
  dateValiditePieceIdentite DateTime?          @db.Date

  entreprise      String?
  siretEntreprise String?

  listeNoire      Boolean @default(false)
  motifListeNoire String?
  notes           String?

  archiveLe   DateTime?
  anonymiseLe DateTime? // RGPD : données personnelles effacées, historique financier conservé
  creeLe      DateTime  @default(now())
  modifieLe   DateTime  @updatedAt

  fichiers                Fichier[]
  contrats                ContratLocation[]
  conduitesAdditionnelles ConducteurAdditionnel[]
  amendes                 Amende[]
  factures                Facture[]

  @@index([nom, prenom])
  @@index([telephone])
  @@index([numeroPermis])
}

// =====================================================================
//  LOCATION — CONTRATS
// =====================================================================

model ContratLocation {
  id         String        @id @default(cuid())
  numero     String        @unique // LOC-AAAA-0001 (via table Compteur)
  vehiculeId String
  vehicule   Vehicule      @relation(fields: [vehiculeId], references: [id])
  clientId   String // conducteur principal
  client     Client        @relation(fields: [clientId], references: [id])
  type       TypeLocation
  statut     StatutContrat @default(RESERVATION)

  // --- Dates ---
  departPrevuLe DateTime
  retourPrevuLe DateTime
  departReelLe  DateTime?
  retourReelLe  DateTime?
  lieuDepart    String?
  lieuRetour    String?
  livraison     Boolean   @default(false)

  // --- Tarification (copie figée au moment du contrat) ---
  // tarifCentimes = prix par unité du type : jour, semaine ou mois.
  tarifCentimes           Int
  dureeFacturee           Int // nombre d'unités (jours / semaines / mois)
  // Jours facturés en plus des unités : reste d'une location hebdomadaire
  // (au tarif journalier) ou dernier mois entamé (mensuel ÷ 30 × jours).
  joursSupplementaires    Int  @default(0)
  tarifJournalierCentimes Int? // tarif journalier figé (hebdomadaire : jours restants)
  remiseCentimes          Int  @default(0)
  fraisLivraisonCentimes  Int  @default(0)
  prixTotalCentimes       Int // tarif × durée − remise + options + livraison
  acompteCentimes         Int? // location courte : acompte demandé
  jourEcheanceMensuelle   Int? // location mensuelle : jour du mois (1–28)

  // --- Kilométrage ---
  kilometrageIllimite Boolean @default(false)
  kmInclusParUnite    Int? // par jour (courte) ou par mois (mensuelle)
  prixKmSupCentimes   Int?

  // --- Caution & franchise ---
  cautionCentimes        Int           @default(0)
  modeCaution            ModeCaution?
  statutCaution          StatutCaution @default(A_ENCAISSER)
  cautionRetenueCentimes Int           @default(0)
  motifRetenueCaution    String?
  cautionEncaisseeLe     DateTime?
  cautionRestitueeLe     DateTime?
  franchiseCentimes      Int?

  // Conditions générales figées au moment de la signature
  conditionsGenerales String?

  notes           String?
  annuleLe        DateTime?
  motifAnnulation String?
  archiveLe       DateTime?
  creeLe          DateTime  @default(now())
  modifieLe       DateTime  @updatedAt

  conducteursAdditionnels ConducteurAdditionnel[]
  options                 OptionContrat[]
  etatsDesLieux           EtatDesLieux[]
  fraisSupplementaires    FraisSupplementaire[]
  echeances               Echeance[]
  paiements               Paiement[]
  amendes                 Amende[]
  sinistres               Sinistre[]
  factures                Facture[]
  fichiers                Fichier[] // PDF signés archivés

  // Anti-chevauchement : vérifié dans l'application ET garanti par une
  // contrainte d'exclusion PostgreSQL (btree_gist) ajoutée en SQL brut dans
  // la migration de la Phase 4.
  @@index([vehiculeId, departPrevuLe, retourPrevuLe])
  @@index([clientId])
  @@index([statut])
}

model ConducteurAdditionnel {
  id        String          @id @default(cuid())
  contratId String
  contrat   ContratLocation @relation(fields: [contratId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id])

  @@unique([contratId, clientId])
}

/// Catalogue des options (paramétrable dans les réglages).
model OptionLocation {
  id              String          @id @default(cuid())
  libelle         String
  modeTarif       ModeTarifOption @default(PAR_JOUR)
  prixCentimes    Int
  plafondCentimes Int? // ex. siège bébé plafonné à 50 €
  actif           Boolean         @default(true)
  ordre           Int             @default(0)

  utilisations OptionContrat[]
}

/// Option ajoutée à un contrat — libellé et prix copiés (figés).
model OptionContrat {
  id            String          @id @default(cuid())
  contratId     String
  contrat       ContratLocation @relation(fields: [contratId], references: [id], onDelete: Cascade)
  optionId      String?
  option        OptionLocation? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  libelle       String
  modeTarif     ModeTarifOption
  prixCentimes  Int
  quantite      Int             @default(1)
  totalCentimes Int
}

// =====================================================================
//  ÉTAT DES LIEUX & DOMMAGES
// =====================================================================

model EtatDesLieux {
  id           String           @id @default(cuid())
  contratId    String
  contrat      ContratLocation  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  type         TypeEtatDesLieux
  realiseLe    DateTime         @default(now())
  realiseParId String?
  realisePar   Utilisateur?     @relation(fields: [realiseParId], references: [id], onDelete: SetNull)

  kilometrage              Int // photo du compteur obligatoire (Fichier EDL_COMPTEUR)
  niveauCarburantHuitiemes Int? // 0 à 8
  niveauBatteriePct        Int? // 0 à 100 (électrique)
  propreteInterieure       Proprete?
  propreteExterieure       Proprete?
  remarques                String?

  // Signatures tactiles (images PNG). Au départ, la signature vaut aussi
  // acceptation du contrat de location.
  signatureClientId   String?   @unique
  signatureClient     Fichier?  @relation("SignatureClient", fields: [signatureClientId], references: [id])
  signatureLoueurId   String?   @unique
  signatureLoueur     Fichier?  @relation("SignatureLoueur", fields: [signatureLoueurId], references: [id])
  nomSignataireClient String?
  signeLe             DateTime?
  verrouille          Boolean   @default(false) // true après signature : plus modifiable

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  checklist         LigneChecklistEdl[]
  photos            Fichier[]           @relation("PhotosEdl")
  dommagesConstates Dommage[]

  @@unique([contratId, type])
}

/// Éléments de check-list paramétrables (clés, carte grise, gilet…).
model ElementChecklist {
  id                   String  @id @default(cuid())
  libelle              String
  avecQuantite         Boolean @default(false) // ex. nombre de clés
  electriqueUniquement Boolean @default(false) // ex. câble de recharge
  ordre                Int     @default(0)
  actif                Boolean @default(true)

  lignes LigneChecklistEdl[]
}

model LigneChecklistEdl {
  id             String            @id @default(cuid())
  etatDesLieuxId String
  etatDesLieux   EtatDesLieux      @relation(fields: [etatDesLieuxId], references: [id], onDelete: Cascade)
  elementId      String?
  element        ElementChecklist? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  libelle        String // copie figée
  present        Boolean
  quantite       Int?
  note           String?
}

/// Un dommage appartient au VÉHICULE (il persiste d'une location à l'autre).
/// Dommages présents à un état des lieux donné =
///   constatés avant cette date ET (non réparés OU réparés après).
model Dommage {
  id          String         @id @default(cuid())
  vehiculeId  String
  vehicule    Vehicule       @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  vue         VueVehicule
  zone        String // identifiant de la zone du schéma SVG (ex. "porte_avant_gauche")
  positionX   Float? // position relative 0–1 sur la vue
  positionY   Float?
  type        TypeDommage
  gravite     GraviteDommage @default(LEGER)
  description String?

  constateLe                 DateTime      @default(now())
  etatDesLieuxConstatationId String? // null = saisi hors EDL (à l'achat…)
  etatDesLieuxConstatation   EtatDesLieux? @relation(fields: [etatDesLieuxConstatationId], references: [id], onDelete: SetNull)
  sinistreId                 String?
  sinistre                   Sinistre?     @relation(fields: [sinistreId], references: [id], onDelete: SetNull)

  repareLe            DateTime?
  depenseReparationId String?
  depenseReparation   Depense?  @relation(fields: [depenseReparationId], references: [id], onDelete: SetNull)

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  photos Fichier[]
  frais  FraisSupplementaire[]

  @@index([vehiculeId, repareLe])
}

// =====================================================================
//  FRAIS, ÉCHÉANCES, PAIEMENTS
// =====================================================================

model FraisSupplementaire {
  id                     String                  @id @default(cuid())
  contratId              String
  contrat                ContratLocation         @relation(fields: [contratId], references: [id], onDelete: Cascade)
  type                   TypeFraisSupplementaire
  libelle                String
  quantite               Int                     @default(1)
  prixUnitaireCentimes   Int
  montantCentimes        Int
  proposeAutomatiquement Boolean                 @default(false) // issu de la comparaison départ/retour
  dommageId              String?
  dommage                Dommage?                @relation(fields: [dommageId], references: [id], onDelete: SetNull)
  amendeId               String?
  amende                 Amende?                 @relation(fields: [amendeId], references: [id], onDelete: SetNull)
  note                   String?
  creeLe                 DateTime                @default(now())

  @@index([contratId])
}

/// Échéances : une par mois en location mensuelle ; acompte + solde en courte durée.
model Echeance {
  id              String          @id @default(cuid())
  contratId       String
  contrat         ContratLocation @relation(fields: [contratId], references: [id], onDelete: Cascade)
  numero          Int
  libelle         String // "Loyer novembre 2026", "Acompte", "Solde"
  dateEcheance    DateTime        @db.Date
  periodeDebut    DateTime?       @db.Date
  periodeFin      DateTime?       @db.Date
  montantCentimes Int
  statut          StatutEcheance  @default(A_VENIR) // recalculé à chaque paiement

  paiements Paiement[]

  @@unique([contratId, numero])
  @@index([dateEcheance, statut])
}

model Paiement {
  id              String          @id @default(cuid())
  numeroRecu      String?         @unique // REC-AAAA-0001
  contratId       String
  contrat         ContratLocation @relation(fields: [contratId], references: [id])
  echeanceId      String?
  echeance        Echeance?       @relation(fields: [echeanceId], references: [id], onDelete: SetNull)
  nature          NaturePaiement  @default(LOCATION)
  date            DateTime        @db.Date
  montantCentimes Int
  mode            ModePaiement
  reference       String?
  note            String?
  creeLe          DateTime        @default(now())

  @@index([contratId])
  @@index([date])
}

// =====================================================================
//  AMENDES & SINISTRES
// =====================================================================

/// Le contrat et le client sont identifiés automatiquement à partir de la
/// date/heure de l'infraction (modifiable).
model Amende {
  id                 String           @id @default(cuid())
  // Véhicule, date et montant restent vides tant que l'avis importé n'est pas lu.
  vehiculeId         String?
  vehicule           Vehicule?        @relation(fields: [vehiculeId], references: [id], onDelete: Restrict)
  infractionLe       DateTime?
  heureInconnue      Boolean          @default(false) // avis sans heure : infractionLe = midi (Paris) ce jour-là
  lieu               String?
  nature             String? // ex. « Excès de vitesse < 20 km/h »
  montantCentimes    Int?
  numeroAvis         String? // 10 chiffres (avis), 12 ou 18 (amende majorée)
  typeAvis           TypeAvis?
  dateAvis           DateTime?        @db.Date // imprimée sur l'avis : départ des 45 jours
  dateReception      DateTime?        @db.Date
  dateLimite         DateTime?        @db.Date // date limite de désignation = date de l'avis + 45 jours
  immatriculationLue String? // telle que lue sur l'avis, normalisée AA-123-AA
  statut             StatutAmende     @default(A_VALIDER)
  contratId          String?
  contrat            ContratLocation? @relation(fields: [contratId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  identificationAuto Boolean          @default(true)
  note               String?

  // --- Import et lecture automatique (Claude) ---
  lotImportId         String?
  lotImport           LotImportAmendes? @relation(fields: [lotImportId], references: [id], onDelete: SetNull)
  fichierPage         Int? // page dans le fichier déposé
  raisonsVerification Json? // [{ code, texte, niveau: "attention" | "blocage" }]
  champsVerifies      String[]          @default([]) // champs corrigés / confirmés à la main
  ocrBrut             Json? // réponse complète de l'extraction (dépannage)
  ocrConfiance        Json? // { numero_avis: "haute" | "moyenne" | "basse", … }
  ocrModele           String?
  ocrTokensEntree     Int?
  ocrTokensSortie     Int?
  ocrTentatives       Int               @default(0)
  ocrEnCoursLe        DateTime? // lecture en cours (file d'attente)
  luLe                DateTime?
  doublonDeId         String?
  doublonDe           Amende?           @relation("DoublonAmende", fields: [doublonDeId], references: [id], onDelete: SetNull)
  doublons            Amende[]          @relation("DoublonAmende")

  // --- Désignation ---
  dateDesignation      DateTime?
  fraisGestionCentimes Int?

  creeParId String?
  creePar   Utilisateur? @relation("AmendesCreees", fields: [creeParId], references: [id], onDelete: SetNull)
  creeLe    DateTime     @default(now())
  modifieLe DateTime     @updatedAt

  fichiers Fichier[]
  frais    FraisSupplementaire[]

  @@index([vehiculeId, infractionLe])
  @@index([statut])
  @@index([dateLimite])
  @@index([clientId])
  @@index([contratId])
  @@index([numeroAvis])
  @@index([lotImportId])
}

/// Un dépôt de scans (un ou plusieurs fichiers) dans Amendes › Importer.
model LotImportAmendes {
  id         String       @id @default(cuid())
  nbFichiers Int          @default(0)
  nbPages    Int          @default(0)
  creeParId  String?
  creePar    Utilisateur? @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  creeLe     DateTime     @default(now())

  amendes Amende[]
}

model Sinistre {
  id                          String           @id @default(cuid())
  vehiculeId                  String
  vehicule                    Vehicule         @relation(fields: [vehiculeId], references: [id])
  contratId                   String?
  contrat                     ContratLocation? @relation(fields: [contratId], references: [id], onDelete: SetNull)
  survenuLe                   DateTime
  lieu                        String?
  description                 String
  coutEstimeCentimes          Int?
  franchiseRefactureeCentimes Int?
  declareAssurance            Boolean          @default(false)
  numeroDossierAssurance      String?
  indemniteAssuranceCentimes  Int? // versé par l'assureur : compte comme revenu du véhicule
  statut                      StatutSinistre   @default(DECLARE)
  note                        String?
  creeLe                      DateTime         @default(now())
  modifieLe                   DateTime         @updatedAt

  fichiers Fichier[]
  depenses Depense[]
  dommages Dommage[]

  @@index([vehiculeId])
}

// =====================================================================
//  FACTURES (sans TVA)
// =====================================================================

/// Numérotation continue FAC-AAAA-0001. Une facture émise n'est jamais
/// modifiée : on l'annule (annuleeLe) et on en émet une nouvelle.
model Facture {
  id                  String           @id @default(cuid())
  numero              String           @unique
  type                TypeFacture
  dateEmission        DateTime         @db.Date
  contratId           String?
  contrat             ContratLocation? @relation(fields: [contratId], references: [id])
  vehiculeId          String?
  vehicule            Vehicule?        @relation(fields: [vehiculeId], references: [id])
  clientId            String?
  client              Client?          @relation(fields: [clientId], references: [id])
  destinataireNom     String // copie figée
  destinataireAdresse String?
  totalCentimes       Int
  mention             String? // mention sans TVA (paramétrable)
  annuleeLe           DateTime?
  motifAnnulation     String?
  creeLe              DateTime         @default(now())

  lignes LigneFacture[]
}

model LigneFacture {
  id                   String  @id @default(cuid())
  factureId            String
  facture              Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  ordre                Int     @default(0)
  libelle              String
  quantite             Int     @default(1)
  prixUnitaireCentimes Int
  totalCentimes        Int
}

// =====================================================================
//  MOUVEMENTS INVESTISSEURS
// =====================================================================

/// Ce qui a déjà été reversé (ou apporté). Reste dû = À reverser − versé.
model Versement {
  id              String        @id @default(cuid())
  partenaireId    String
  partenaire      Partenaire    @relation(fields: [partenaireId], references: [id])
  vehiculeId      String?
  vehicule        Vehicule?     @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)
  date            DateTime      @db.Date
  montantCentimes Int
  type            TypeVersement
  mode            ModePaiement?
  reference       String?
  note            String?
  creeLe          DateTime      @default(now())
  modifieLe       DateTime      @updatedAt

  @@index([partenaireId, date])
  @@index([vehiculeId])
}

// =====================================================================
//  FICHIERS (photos, justificatifs, scans, signatures, PDF archivés)
// =====================================================================

/// Table unique pour tous les fichiers. Le fichier physique est dans /storage
/// (via lib/storage.ts — remplaçable par S3/R2). Un seul « propriétaire »
/// renseigné par fichier. Servi uniquement via /api/fichiers/[id] avec
/// contrôle des droits.
model Fichier {
  id            String           @id @default(cuid())
  categorie     CategorieFichier
  cleStockage   String           @unique // chemin relatif dans le stockage
  nomOriginal   String
  typeMime      String
  tailleOctets  Int
  largeur       Int?
  hauteur       Int?
  libelle       String?
  ordre         Int              @default(0)
  estPrincipale Boolean          @default(false) // photo principale du véhicule
  // --- Site public (photos de véhicule uniquement) ---
  publique      Boolean          @default(false) // servie par la route publique si l'annonce est en ligne
  ordrePublic   Int              @default(0) // ordre dans l'annonce (glisser-déposer)
  recadrage     Json? // zone 4:3 choisie, en % de l'image : { x, y, l } (h déduit de l'image)
  envoyeParId   String?
  envoyePar     Utilisateur?     @relation(fields: [envoyeParId], references: [id], onDelete: SetNull)
  creeLe        DateTime         @default(now())

  // --- Propriétaire (un seul) ---
  vehiculeId     String?
  vehicule       Vehicule?        @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  depenseId      String?
  depense        Depense?         @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contratId      String?
  contrat        ContratLocation? @relation(fields: [contratId], references: [id], onDelete: Cascade)
  etatDesLieuxId String?
  etatDesLieux   EtatDesLieux?    @relation("PhotosEdl", fields: [etatDesLieuxId], references: [id], onDelete: Cascade)
  dommageId      String?
  dommage        Dommage?         @relation(fields: [dommageId], references: [id], onDelete: Cascade)
  sinistreId     String?
  sinistre       Sinistre?        @relation(fields: [sinistreId], references: [id], onDelete: Cascade)
  amendeId       String?
  amende         Amende?          @relation(fields: [amendeId], references: [id], onDelete: Cascade)

  // --- Relations inverses (signatures, logo) ---
  signatureClientDe EtatDesLieux? @relation("SignatureClient")
  signatureLoueurDe EtatDesLieux? @relation("SignatureLoueur")
  logoDe            Reglages?     @relation("LogoSociete")

  @@index([vehiculeId, categorie])
  @@index([clientId])
  @@index([depenseId])
  @@index([etatDesLieuxId])
}

// =====================================================================
//  RÉGLAGES & NUMÉROTATION
// =====================================================================

/// Ligne unique (id = 1).
model Reglages {
  id Int @id @default(1)

  // --- Société (utilisé dans les PDF) ---
  societeNom        String   @default("VUCA AUTO")
  societeAdresse    String?
  societeCodePostal String?
  societeVille      String?
  societeSiret      String?
  societeTelephone  String?
  societeEmail      String?
  logoId            String?  @unique
  logo              Fichier? @relation("LogoSociete", fields: [logoId], references: [id], onDelete: SetNull)

  // --- Documents ---
  conditionsGenerales  String? // CGV de location (texte long)
  mentionFacture       String? // mention « sans TVA » à valider par le comptable
  mentionsContrat      String?
  mentionsEtatDesLieux String?
  prefixeContrat       String  @default("LOC")
  prefixeFacture       String  @default("FAC")
  prefixeRecu          String  @default("REC")

  // --- Seuils d'alertes ---
  joursStockAlerte            Int @default(90)
  joursAvantEcheanceAlerte    Int @default(30) // CT, assurance
  kmAvantVidangeAlerte        Int @default(1000)
  anciennetePermisMinAnnees   Int @default(2)
  toleranceRetardMinutes      Int @default(60) // journée entamée due au-delà
  jourEcheanceMensuelleDefaut Int @default(1)

  // --- Frais proposés au retour d'une location ---
  fraisNettoyageCentimes        Int @default(5000) // véhicule rendu sale
  prixHuitiemeCarburantCentimes Int @default(1500) // par 1/8 de réservoir manquant
  prixPourcentBatterieCentimes  Int @default(50) // par % de batterie manquant

  // --- Amendes (désignation ANTAI) : vide = reprend les champs « Société » ---
  amendesRaisonSociale        String? // exactement comme sur les avis
  amendesAdresse              String?
  amendesAdresseComplement    String?
  amendesCodePostal           String?
  amendesVille                String?
  amendesEmail                String? // reçoit les confirmations de l'ANTAI
  amendesFraisGestionCentimes Int     @default(0) // par PV désigné, 0 = désactivé
  amendesModele               String  @default("claude-haiku-5-5")

  modifieLe DateTime @updatedAt
}

/// Compteurs de numérotation (ex. cle "LOC-2026" → 12). Incrémentés dans une
/// transaction pour garantir des numéros uniques et continus.
model Compteur {
  cle    String @id
  valeur Int    @default(0)
}

// =====================================================================
//  SITE WEB PUBLIC (vuca-auto.fr) — piloté depuis le CRM
//  Les pages publiques ne lisent ces données qu'à travers toPublicVehicle()
//  et les lectures de src/server/site (listes blanches).
// =====================================================================

enum SourceAvis {
  GOOGLE
  LEBONCOIN
  DIRECT
}

enum TypeStatSite {
  VUE_SITE
  VUE_ANNONCE
  CLIC_WHATSAPP
  CLIC_APPEL
}

/// Annonce publique d'un véhicule (une par véhicule).
model Annonce {
  id         String   @id @default(cuid())
  vehiculeId String   @unique
  vehicule   Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  reference  String   @unique // VA-0042
  slug       String   @unique // figé à la 1re publication

  publiee     Boolean   @default(false)
  publieeLe   DateTime? // 1re mise en ligne
  depublieeLe DateTime?

  titre               String
  prixAfficheCentimes Int?
  prixNegociable      Boolean @default(false)
  puissanceCh         Int?
  description         String? // texte simple : **gras** et listes « - »
  equipements         Json    @default("{}") // { confort: [], securite: [], multimedia: [], exterieur: [], autres: [] }

  // Points de confiance (affichés seulement si cochés)
  ctAJour             Boolean   @default(false)
  ctDate              DateTime? @db.Date
  carnetEntretien     Boolean   @default(false)
  rapportHistovec     Boolean   @default(false)
  nombreProprietaires Int?
  premiereMain        Boolean   @default(false)
  garantieMois        Int?
  garantieTexte       String?
  nonFumeur           Boolean   @default(false)
  reviseAvantVente    Boolean   @default(false)
  travauxRealises     String?
  kilometrageVerifie  Boolean   @default(false)
  sourceKilometrage   String?

  couvertureId String? // photo de couverture (Fichier publique du véhicule)
  misAJourLe   DateTime @default(now()) // « Annonce mise à jour le … »
  creeLe       DateTime @default(now())
  modifieLe    DateTime @updatedAt

  statistiques StatistiqueSite[]

  @@index([publiee])
}

/// Réglages du site public (ligne unique, id = 1).
model ReglagesSite {
  id Int @id @default(1)

  // --- Général ---
  enLigne       Boolean @default(false) // false = page « Bientôt de retour »
  nomAffiche    String  @default("VUCA AUTO")
  slogan        String?
  couleurAccent String  @default("#FFD60A")
  logoClairId   String? // IMAGE_SITE
  logoFonceId   String?
  faviconId     String?

  // --- Contact & WhatsApp ---
  whatsapp                String? // +33612345678
  messageWhatsappVehicule String  @default("Bonjour, je suis intéressé par la {marque} {modele} {annee} à {prix} ({lien}). Est-elle toujours disponible ?")
  messageWhatsappGeneral  String  @default("Bonjour, je souhaiterais avoir des informations sur vos véhicules.")
  telephone               String?
  email                   String?
  adresse                 String?
  lienGoogleMaps          String?
  horaires                Json    @default("[]") // 7 jours : { jour, ouvert, plages }
  delaiReponse            String?
  vendeurNom              String?
  vendeurPhotoId          String?

  // --- Confiance ---
  siret                  String?
  formeJuridique         String?
  adresseSiege           String?
  engagements            Json    @default("[]") // { icone, titre, phrase, actif }
  moyensPaiement         Json    @default("[]") // libellés
  livraison              Boolean @default(false)
  zoneLivraison          String?
  reprise                Boolean @default(false)
  lienAvisGoogle         String?
  afficherVendus         Boolean @default(false)
  joursVendus            Int     @default(60)
  afficherNombreVendus   Boolean @default(false)
  seuilNombreVendus      Int     @default(20)
  anneeCreation          Int?
  immatriculationVisible Boolean @default(false)

  // --- Contenu ---
  accueilTitre     String?
  accueilSousTitre String?
  aProposTexte     String?
  aProposPhotoId   String?
  faq              Json    @default("[]") // { question, reponse }
  bandeau          String?
  reseaux          Json    @default("{}") // { instagram, tiktok, facebook, leboncoin, lacentrale }

  // --- Référencement ---
  seoTitre          String?
  seoDescription    String?
  imagePartageId    String?
  plausibleDomaine  String?
  googleAnalyticsId String?

  // --- Légal (vide = texte généré automatiquement) ---
  mentionsLegales String?
  confidentialite String?

  modifieLe DateTime @updatedAt
}

/// Avis client réel (saisi à la main, authenticité certifiée).
model AvisClient {
  id                  String     @id @default(cuid())
  auteur              String // prénom + initiale
  note                Int // 1 à 5
  texte               String
  date                DateTime   @db.Date
  vehiculeAchete      String?
  source              SourceAvis @default(DIRECT)
  certifieAuthentique Boolean
  actif               Boolean    @default(true)
  ordre               Int        @default(0)
  creeLe              DateTime   @default(now())
}

/// Compteurs agrégés par jour (aucune donnée personnelle, aucune adresse IP).
model StatistiqueSite {
  id        String       @id @default(cuid())
  jour      DateTime     @db.Date
  type      TypeStatSite
  cle       String // id de l'annonce, ou « site »
  annonceId String?
  annonce   Annonce?     @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  compte    Int          @default(0)

  @@unique([jour, type, cle])
  @@index([annonceId, jour])
}
