# =====================================================================
#  VUCA AUTO CRM — variables d'environnement
#  Copier ce fichier en « .env » puis adapter les valeurs.
#  Ne JAMAIS partager le fichier .env (il contient des secrets).
# =====================================================================

# --- Base de données PostgreSQL --------------------------------------
# Mot de passe de la base : choisissez-en un long, avec UNIQUEMENT des
# lettres et des chiffres (pas d'espace, ni @ : / ? #).
POSTGRES_PASSWORD=ChangezMoi2026
# Adresse de la base : uniquement pour le développement SANS Docker
# (avec Docker, elle est calculée automatiquement à partir du mot de passe).
DATABASE_URL=postgresql://vuca:ChangezMoi2026@localhost:5432/vuca_crm

# --- Connexion (Auth.js) ---------------------------------------------
# Clé secrète qui protège les sessions. Laissez tel quel : avec Docker, une clé
# est générée automatiquement au premier démarrage. (Pour en fixer une vous-même :
# openssl rand -base64 32)
AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Adresse publique de l'application (sans / final).
AUTH_URL=http://localhost:3000
# Nécessaire derrière Docker / un proxy.
AUTH_TRUST_HOST=true

# --- Fichiers (photos, justificatifs, scans) -------------------------
# Dossier de stockage (développement sans Docker). Avec Docker : volume « fichiers ».
STORAGE_DIR=./storage

# --- Données de démonstration ----------------------------------------
# true = au tout premier démarrage, la base est remplie avec des données de démo.
SEED_DEMO=true

# --- Port de l'application sur votre ordinateur ----------------------
APP_PORT=3000
# 0.0.0.0 = joignable depuis le réseau local (téléphone sur le même Wi-Fi).
# Sur un serveur en ligne : 127.0.0.1 (seul le proxy HTTPS y accède).
APP_ADRESSE=0.0.0.0

# --- Sauvegarde automatique (Docker) ----------------------------------
# Heure de la sauvegarde quotidienne (base + fichiers, dossier « sauvegardes »)
HEURE_SAUVEGARDE=03:30
# Nombre de jours de conservation
GARDER_JOURS=30
